
@page "/register"
@using CarRentalFE.Models
@using CarRentalFE.Services
@using Microsoft.AspNetCore.Components.Forms
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Đăng ký tài khoản - Car Rental</PageTitle>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-5">

            <div class="card border-0 shadow rounded-4">
                <div class="card-body p-4 p-md-5">

                    <h2 class="text-center fw-bold mb-2">
                        Đăng ký tài khoản
                    </h2>

                    <p class="text-center text-muted mb-4">
                        Tạo tài khoản để bắt đầu thuê xe
                    </p>

                    <EditForm Model="@registerModel"
                              OnValidSubmit="HandleRegister"
                              FormName="registerForm">

                        <DataAnnotationsValidator />

                        <!-- Họ và tên -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">
                                Họ và tên
                            </label>

                            <InputText class="form-control"
                                       placeholder="Nguyễn Văn A"
                                       @bind-Value="registerModel.FullName" />

                            <ValidationMessage
                                For="@(() => registerModel.FullName)" />
                        </div>

                        <!-- Email -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">
                                Email
                            </label>

                            <InputText class="form-control"
                                       type="email"
                                       placeholder="example@gmail.com"
                                       @bind-Value="registerModel.Email" />

                            <ValidationMessage
                                For="@(() => registerModel.Email)" />
                        </div>

                        <!-- Số điện thoại -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">
                                Số điện thoại
                            </label>

                            <InputText class="form-control"
                                       type="tel"
                                       placeholder="0912345678"
                                       @bind-Value="registerModel.Phone" />

                            <ValidationMessage
                                For="@(() => registerModel.Phone)" />
                        </div>

                        <!-- Mật khẩu -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">
                                Mật khẩu
                            </label>

                            <InputText class="form-control"
                                       type="password"
                                       placeholder="Tối thiểu 8 ký tự"
                                       @bind-Value="registerModel.Password" />

                            <ValidationMessage
                                For="@(() => registerModel.Password)" />
                        </div>

                        <!-- Xác nhận mật khẩu -->
                        <div class="mb-3">
                            <label class="form-label fw-semibold">
                                Xác nhận mật khẩu
                            </label>

                            <InputText class="form-control"
                                       type="password"
                                       placeholder="Nhập lại mật khẩu"
                                       @bind-Value="registerModel.ConfirmPassword" />

                            <ValidationMessage
                                For="@(() => registerModel.ConfirmPassword)" />
                        </div>

                        <!-- Thông báo lỗi -->
                        @if (!string.IsNullOrWhiteSpace(errorMessage))
                        {
                            <div class="alert alert-danger" role="alert">
                                @errorMessage
                            </div>
                        }

                        <!-- Nút đăng ký -->
                        <button type="submit"
                                class="btn btn-primary w-100 py-2 fw-semibold"
                                disabled="@isLoading">

                            @if (isLoading)
                            {
                                <span class="spinner-border spinner-border-sm me-2"
                                      aria-hidden="true"></span>
                                <span>Đang đăng ký...</span>
                            }
                            else
                            {
                                <span>Đăng ký</span>
                            }
                        </button>

                    </EditForm>

                    <div class="text-center mt-4">
                        <span class="text-muted">
                            Đã có tài khoản?
                        </span>

                        <a href="/login"
                           class="text-decoration-none fw-semibold">
                            Đăng nhập
                        </a>
                    </div>

                </div>
            </div>

        </div>
    </div>
</div>

@code {
    private RegisterRequest registerModel = new();

    private bool isLoading = false;
    private string errorMessage = "";

    private async Task HandleRegister()
    {
        if (isLoading)
            return;

        isLoading = true;
        errorMessage = "";

        try
        {
            bool success =
                await AuthService.RegisterAsync(registerModel);

            if (success)
            {
                Navigation.NavigateTo("/login");
            }
            else
            {
                errorMessage =
                    "Đăng ký thất bại. Email có thể đã tồn tại.";
            }
        }
        catch (HttpRequestException)
        {
            errorMessage =
                "Không thể kết nối đến Backend API.";
        }
        catch (Exception)
        {
            errorMessage =
                "Có lỗi xảy ra. Vui lòng thử lại.";
        }
        finally
        {
            isLoading = false;
        }
    }
}
