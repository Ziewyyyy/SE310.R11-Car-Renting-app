
@page "/admin/support"
@layout AdminLayout

<PageTitle>Hỗ trợ | RENTO</PageTitle>

<div class="support-page">

    <!-- PAGE HEADER -->
    <div class="support-heading">
        <div>
            <h1>Trung tâm hỗ trợ</h1>
            <p>Tiếp nhận và xử lý yêu cầu của khách hàng theo thời gian thực.</p>
        </div>

        <div class="support-summary">
            <span class="summary-high">● 3 ưu tiên cao</span>
            <span class="summary-pending">● 8 đang chờ</span>
        </div>
    </div>

    <!-- SUPPORT WORKSPACE -->
    <div class="support-workspace">

        <!-- LEFT: TICKET LIST -->
        <aside class="support-sidebar">

            <div class="support-search">
                <span>⌕</span>
                <input placeholder="Tìm mã, tiêu đề, khách hàng..."
                       @bind="searchText"
                       @bind:event="oninput" />

                <button type="button" title="Lọc" @onclick="ToggleFilter">
                    <span>▽</span>
                </button>
            </div>

            @if (showFilter)
            {
                <div class="support-filter">
                    <label>Trạng thái yêu cầu</label>
                    <select @bind="statusFilter">
                        <option value="">Tất cả trạng thái</option>
                        <option value="Đang xử lý">Đang xử lý</option>
                        <option value="Chờ phản hồi">Chờ phản hồi</option>
                        <option value="Đã giải quyết">Đã giải quyết</option>
                    </select>

                    <label>Mức độ ưu tiên</label>
                    <select @bind="priorityFilter">
                        <option value="">Tất cả mức độ</option>
                        <option value="Cao">Cao</option>
                        <option value="Trung bình">Trung bình</option>
                        <option value="Thấp">Thấp</option>
                    </select>
                </div>
            }

            <div class="support-list-heading">
                <strong>@filteredTickets.Count() yêu cầu</strong>

                <select @bind="sortOrder">
                    <option value="newest">Mới nhất</option>
                    <option value="oldest">Cũ nhất</option>
                </select>
            </div>

            <div class="support-ticket-list">

                @foreach (var ticket in filteredTickets)
                {
                    <button type="button"
                            class="support-ticket @(selectedTicket?.Id == ticket.Id ? "selected" : "")"
                            @onclick="() => SelectTicket(ticket)">

                        <div class="ticket-topline">
                            <strong>@ticket.Code</strong>
                            <small>@ticket.TimeAgo</small>
                        </div>

                        <h3>@ticket.Title</h3>

                        <div class="ticket-customer">
                            <span class="ticket-avatar">@GetInitials(ticket.Customer)</span>
                            <span>@ticket.Customer</span>

                            <span class="priority-tag @GetPriorityClass(ticket.Priority)">
                                @ticket.Priority
                            </span>
                        </div>

                        <div class="ticket-bottomline">
                            <span class="ticket-status @GetStatusClass(ticket.Status)">
                                <i></i>@ticket.Status
                            </span>

                            <small>@ticket.AssigneeCode</small>
                        </div>

                    </button>
                }

                @if (!filteredTickets.Any())
                {
                    <div class="support-no-ticket">
                        Không tìm thấy yêu cầu hỗ trợ.
                    </div>
                }

            </div>
        </aside>

        <!-- CENTER: CONVERSATION -->
        @if (selectedTicket is not null)
        {
            <main class="support-conversation">

                <!-- CONVERSATION HEADER -->
                <div class="conversation-header">

                    <div class="conversation-title">
                        <span class="conversation-code">
                            @selectedTicket.Code · @selectedTicket.Category.ToUpper()
                        </span>

                        <h2>@selectedTicket.Title</h2>

                        <small>
                            Được tạo lúc @selectedTicket.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                        </small>
                    </div>

                    <div class="conversation-actions">

                        <div class="conversation-select">
                            <label>Gán cho</label>
                            <select @bind="selectedTicket.AssigneeCode">
                                <option value="NV-0024">NV-0024 · Hoàng Minh</option>
                                <option value="NV-0025">NV-0025 · Lan Anh</option>
                                <option value="NV-0026">NV-0026 · Quốc Huy</option>
                            </select>
                        </div>

                        <div class="conversation-select status-select">
                            <label>Trạng thái</label>
                            <select @bind="selectedTicket.Status">
                                <option value="Đang xử lý">Đang xử lý</option>
                                <option value="Chờ phản hồi">Chờ phản hồi</option>
                                <option value="Đã giải quyết">Đã giải quyết</option>
                            </select>
                        </div>

                    </div>
                </div>

                <!-- MESSAGE HISTORY -->
                <div class="conversation-body">

                    <div class="conversation-date">
                        <span></span>
                        <small>Hôm nay, @DateTime.Now.ToString("dd/MM/yyyy")</small>
                        <span></span>
                    </div>

                    @foreach (var message in selectedTicket.Messages)
                    {
                        @if (message.IsSystem)
                        {
                            <div class="system-message">
                                <span>♧</span>
                                <div>
                                    <strong>@message.Content</strong>
                                    <small>@message.Time.ToString("HH:mm")</small>
                                </div>
                            </div>
                        }
                        else if (message.IsInternal)
                        {
                            <div class="internal-message">
                                <div class="message-meta">
                                    <strong>Ghi chú nội bộ</strong>
                                    <small>@message.Time.ToString("HH:mm")</small>
                                </div>
                                <p>@message.Content</p>
                            </div>
                        }
                        else
                        {
                            <div class="message-row @(message.IsStaff ? "staff-message" : "customer-message")">

                                <span class="message-avatar">
                                    @GetInitials(message.Sender)
                                </span>

                                <div class="message-content">

                                    <div class="message-meta">
                                        <strong>@message.Sender</strong>
                                        <small>@message.Time.ToString("HH:mm")</small>
                                    </div>

                                    <div class="message-bubble">
                                        @message.Content
                                    </div>

                                    @if (!string.IsNullOrWhiteSpace(message.Attachment))
                                    {
                                        <div class="message-attachment">
                                            <span>▤</span>
                                            <div>
                                                <strong>@message.Attachment</strong>
                                                <small>1.2 MB · Tệp đính kèm</small>
                                            </div>
                                        </div>
                                    }

                                </div>
                            </div>
                        }
                    }

                </div>

                <!-- REPLY AREA -->
                <div class="support-reply">

                    <div class="reply-tabs">
                        <button type="button"
                                class="reply-tab @(replyMode == "reply" ? "active" : "")"
                                @onclick='() => ChangeReplyMode("reply")'>
                            Phản hồi khách hàng
                        </button>

                        <button type="button"
                                class="reply-tab @(replyMode == "internal" ? "active" : "")"
                                @onclick='() => ChangeReplyMode("internal")'>
                            Ghi chú nội bộ
                        </button>
                    </div>

                    <textarea @bind="replyContent"
                              rows="3"
                              placeholder="@(replyMode == "reply"
                                  ? "Nhập nội dung phản hồi..."
                                  : "Nhập ghi chú nội bộ...")"></textarea>

                    @if (!string.IsNullOrWhiteSpace(replyError))
                    {
                        <div class="reply-error">@replyError</div>
                    }

                    <div class="reply-footer">

                        <div class="reply-attachment">
                            <label class="attachment-button">
                                <span>＋</span>
                                Đính kèm tệp
                                <InputFile accept="image/*,.pdf,.doc,.docx"
                                           OnChange="HandleAttachment" />
                            </label>

                            @if (!string.IsNullOrWhiteSpace(attachmentName))
                            {
                                <span class="attachment-name">@attachmentName</span>
                            }
                        </div>

                        <button type="button"
                                class="send-reply-button"
                                @onclick="SendReply">
                            Gửi phản hồi →
                        </button>

                    </div>
                </div>

            </main>

            <!-- RIGHT: CUSTOMER INFORMATION -->
            <aside class="support-customer-info">

                <div class="customer-profile-header">
                    <span class="profile-avatar">
                        @GetInitials(selectedTicket.Customer)
                    </span>

                    <strong>@selectedTicket.Customer</strong>
                    <small>KH-01842 · Thành viên bạc</small>
                </div>

                <div class="customer-info-section">
                    <h4>Thông tin liên hệ</h4>
                    <span>@selectedTicket.Phone</span>
                    <span>@selectedTicket.Email</span>
                </div>

                <div class="customer-info-section">
                    <h4>Đơn thuê liên quan</h4>
                    <a href="/admin/orders">@selectedTicket.OrderCode ›</a>
                    <span>@selectedTicket.Car</span>
                    <span>@selectedTicket.RentalDate</span>
                </div>

                <div class="customer-statistics">
                    <div>
                        <strong>@selectedTicket.TotalOrders</strong>
                        <small>Đơn thuê</small>
                    </div>

                    <div>
                        <strong>@selectedTicket.PreviousTickets</strong>
                        <small>Yêu cầu hỗ trợ</small>
                    </div>
                </div>

            </aside>
        }

    </div>
</div>

@code {
