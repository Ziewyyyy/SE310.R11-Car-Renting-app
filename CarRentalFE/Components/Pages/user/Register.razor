@page "/register"
@layout EmptyLayout
@rendermode InteractiveServer

@using System.ComponentModel.DataAnnotations
@using CarRentalFE.Models.Auth
@using CarRentalFE.Services
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Đăng ký | RENTO</PageTitle>

<div class="user-login-page">
    <header class="user-login-header">
        <a href="/" class="user-login-logo">
            <span class="user-login-logo-icon">R</span>
            RENTO
        </a>
        <div class="user-login-header-right">
            Đã có tài khoản? <a href="/login">Đăng nhập</a>
        </div>
    </header>

    <main class="user-login-content">
        <div class="user-login-decoration decoration-one"></div>
        <div class="user-login-decoration decoration-two"></div>

        <div class="user-login-card">
            <div class="user-login-intro">
                <div class="user-login-icon">🚗</div>
                <h1>Tạo tài khoản RENTO</h1>
                <p>Đăng ký để bắt đầu trải nghiệm dịch vụ thuê xe.</p>
            </div>

            <EditForm Model="@model" OnValidSubmit="@HandleRegister">
                <DataAnnotationsValidator />

                <div class="user-login-field">
                    <label>Họ và tên</label>
                    <InputText class="user-login-input" @bind-Value="model.FullName" placeholder="Nhập họ và tên" />
                    <ValidationMessage class="validation-message" For="@(() => model.FullName)" />
                </div>

                <div class="user-login-field">
                    <label>Email</label>
                    <InputText class="user-login-input" @bind-Value="model.Email" placeholder="example@gmail.com" />
                    <ValidationMessage class="validation-message" For="@(() => model.Email)" />
                </div>

                <div class="user-login-field">
                    <label>Số điện thoại</label>
                    <InputText class="user-login-input" @bind-Value="model.Phone" placeholder="Nhập số điện thoại" />
                    <ValidationMessage class="validation-message" For="@(() => model.Phone)" />
                </div>

                <div class="user-login-field">
                    <label>Mật khẩu</label>
                    <InputText class="user-login-input" type="password" @bind-Value="model.Password"
                        placeholder="Tối thiểu 8 ký tự" />
                    <ValidationMessage class="validation-message" For="@(() => model.Password)" />
                </div>

                @if (!string.IsNullOrEmpty(message))
                {
                    <div class="user-login-error">@message</div>
                }

                <button type="submit" class="user-login-submit" disabled="@isLoading">
                    @(isLoading ? "Đang đăng ký..." : "Đăng ký")
                    <span>→</span>
                </button>
            </EditForm>

            <div class="user-login-divider">hoặc</div>
            <div class="user-login-register">
                Đã có tài khoản? <a href="/login">Đăng nhập</a>
            </div>
        </div>
    </main>
</div>

@code {
    private RegisterModel model = new();
    private string message = "";
    private bool isLoading;

    private async Task HandleRegister()
    {
        message = "";
        isLoading = true;

        try
        {
            var request = new RegisterRequest
            {
                FullName = model.FullName,
                Email = model.Email,
                Phone = model.Phone,
                Password = model.Password
            };

            var result = await AuthService.RegisterAsync(request);

            message = result.Message;

            if (result.Success)
            {
                Navigation.NavigateTo("/login");
            }
        }
        finally
        {
            isLoading = false;
        }
    }

    public class RegisterModel
    {
        [Required(ErrorMessage = "Vui lòng nhập họ tên.")]
        public string FullName { get; set; } = "";

        [Required(ErrorMessage = "Vui lòng nhập email.")]
        [EmailAddress(ErrorMessage = "Email không hợp lệ.")]
        public string Email { get; set; } = "";

        [Required(ErrorMessage = "Vui lòng nhập số điện thoại.")]
        public string Phone { get; set; } = "";

        [Required(ErrorMessage = "Vui lòng nhập mật khẩu.")]
        [MinLength(8, ErrorMessage = "Mật khẩu tối thiểu 8 ký tự.")]
        public string Password { get; set; } = "";
    }
}