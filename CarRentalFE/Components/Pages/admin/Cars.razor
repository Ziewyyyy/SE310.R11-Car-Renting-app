@page "/admin/cars"
@layout AdminLayout
@using System.ComponentModel.DataAnnotations
@using System.Net.Http.Json
@using Microsoft.AspNetCore.Components.Forms
@inject HttpClient Http

<PageTitle>Quản lý xe | RENTO</PageTitle>

<div class="admin-cars-page">
    <div class="cars-page-heading">
        <div>
            <div class="cars-eyebrow">QUẢN LÝ PHƯƠNG TIỆN</div>
            <h1>Đội xe RENTO</h1>
            <p>Theo dõi và quản lý @total phương tiện trong hệ thống.</p>
        </div>
        <button class="cars-primary-button" type="button" @onclick="OpenAddModal">
            <span>＋</span> Thêm xe mới
        </button>
    </div>

    <div class="cars-tabs">
        <button class="cars-tab @(activeTab == "list" ? "active" : "")" @onclick='() => activeTab = "list"'>Danh sách xe</button>
        <button class="cars-tab @(activeTab == "types" ? "active" : "")" @onclick='() => activeTab = "types"'>Loại xe</button>
        <button class="cars-tab @(activeTab == "brands" ? "active" : "")" @onclick='() => activeTab = "brands"'>Hãng xe</button>
    </div>

    @if (activeTab == "list")
    {
        <section class="cars-table-card">
            <div class="cars-toolbar">
                <div class="cars-toolbar-left">
                    <label class="cars-search">
                        <span>⌕</span>
                        <input placeholder="Tìm xe, biển số... (Enter)" @bind="searchText" @bind:after="ApplyFilter" />
                    </label>

                    <label class="cars-select-wrap">
                        <span>Hãng</span>
                        <select @bind="selectedBrandId" @bind:after="ApplyFilter">
                            <option value="">Tất cả hãng</option>
                            @foreach (var b in brands)
                            {
                                <option value="@b.Id">@b.Name</option>
                            }
                        </select>
                    </label>

                    <label class="cars-select-wrap">
                        <span>Trạng thái</span>
                        <select @bind="selectedStatus" @bind:after="ApplyFilter">
                            <option value="">Mọi trạng thái</option>
                            @foreach (var s in StatusMap)
                            {
                                <option value="@s.Key">@s.Value.Label</option>
                            }
                        </select>
                    </label>
                </div>
                <button class="cars-filter-button" type="button" @onclick="ClearFilters"><span>▽</span> Bỏ lọc</button>
            </div>

            <div class="cars-table-scroll">
                <table class="cars-table">
                    <thead>
                        <tr>
                            <th>PHƯƠNG TIỆN</th>
                            <th>BIỂN SỐ</th>
                            <th>HÃNG / LOẠI</th>
                            <th>SỐ KM</th>
                            <th>GIÁ / NGÀY</th>
                            <th>TRẠNG THÁI</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (loading)
                        {
                            <tr><td colspan="7" class="cars-empty">Đang tải...</td></tr>
                        }
                        else
                        {
                            @foreach (var car in cars)
                            {
                                var st = StatusInfo(car.Status);
                                <tr>
                                    <td>
                                        <div class="car-name-cell">
                                            <div class="car-thumb">
                                                @if (!string.IsNullOrEmpty(car.PrimaryImage))
                                                {
                                                    <img src="@car.PrimaryImage" alt="@car.Name" />
                                                }
                                                else
                                                {
                                                    <span>🚗</span>
                                                }
                                            </div>
                                            <strong>@car.Name</strong>
                                        </div>
                                    </td>
                                    <td class="plate-cell">@car.LicensePlate</td>
                                    <td>
                                        <strong class="brand-name">@car.BrandName</strong>
                                        <small class="car-type">@car.CategoryName</small>
                                    </td>
                                    <td>@car.Mileage.ToString("N0") km</td>
                                    <td class="car-price">@car.PricePerDay.ToString("N0") ₫</td>
                                    <td>
                                        <span class="car-status @st.Css"><i></i>@st.Label</span>
                                    </td>
                                    <td class="car-more">
                                        <button type="button" title="Sửa" @onclick="() => OpenEditModal(car)">✎</button>
                                        @if (car.Status != "Inactive")
                                        {
                                            <button type="button" title="Ngừng hoạt động" @onclick="() => AskDelete(car)">🗑</button>
                                        }
                                    </td>
                                </tr>
                            }

                            @if (!cars.Any())
                            {
                                <tr><td colspan="7" class="cars-empty">Không tìm thấy phương tiện phù hợp.</td></tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <div class="cars-table-footer">
                <span>Hiển thị @cars.Count trong @total xe</span>
                <div class="cars-pagination">
                    <button disabled="@(currentPage == 1)" @onclick="() => GoToPage(currentPage - 1)">‹</button>
                    @for (var p = 1; p <= TotalPages; p++)
                    {
                        var n = p;
                        <button class="@(currentPage == n ? "current" : "")" @onclick="() => GoToPage(n)">@n</button>
                    }
                    <button disabled="@(currentPage == TotalPages)" @onclick="() => GoToPage(currentPage + 1)">›</button>
                </div>
            </div>
        </section>
    }
    else if (activeTab == "types")
    {
        <section class="cars-management-panel">
            <div class="cars-management-heading">
                <div>
                    <h2>Danh mục loại xe</h2>
                    <p>Phân loại phương tiện đang kinh doanh tại RENTO.</p>
                </div>
                <button class="cars-outline-button" type="button" @onclick='() => OpenCatalogModal("category", null)'>
                    ＋ Thêm loại xe
                </button>
            </div>
            <div class="cars-category-grid">
                @foreach (var t in categories)
                {
                    <article class="cars-category-card">
                        <span class="category-icon">▣</span>
                        <div>
                            <strong>@t.Name</strong>
                            <small>@t.CarCount phương tiện@(string.IsNullOrWhiteSpace(t.Description) ? "" : " · " + t.Description)</small>
                        </div>
                        <span class="category-arrow">
                            <button type="button" title="Sửa" @onclick='() => OpenCatalogModal("category", t.Id)'>✎</button>
                            <button type="button" title="Xóa" @onclick='() => AskDeleteCatalog("category", t.Id, t.Name)'>🗑</button>
                        </span>
                    </article>
                }
                @if (!categories.Any())
                {
                    <p class="cars-empty">Chưa có loại xe nào.</p>
                }
            </div>
        </section>
    }
    else
    {
        <section class="cars-management-panel">
            <div class="cars-management-heading">
                <div>
                    <h2>Danh mục hãng xe</h2>
                    <p>Các thương hiệu xe có trong hệ thống.</p>
                </div>
                <button class="cars-outline-button" type="button" @onclick='() => OpenCatalogModal("brand", null)'>
                    ＋ Thêm hãng xe
                </button>
            </div>
            <div class="cars-brand-list">
                @foreach (var b in brands)
                {
                    <div class="cars-brand-row">
                        <div class="brand-logo">@(b.Name.Length > 0 ? b.Name[..1] : "?")</div>
                        <strong>@b.Name</strong>
                        <span>@(string.IsNullOrWhiteSpace(b.Country) ? "" : b.Country + " · ")@b.CarCount xe</span>
                        <button type="button" @onclick="() => ShowCarsOfBrand(b.Id)">Xem xe ›</button>
                        <button type="button" title="Sửa" @onclick='() => OpenCatalogModal("brand", b.Id)'>✎</button>
                        <button type="button" title="Xóa" @onclick='() => AskDeleteCatalog("brand", b.Id, b.Name)'>🗑</button>
                    </div>
                }
                @if (!brands.Any())
                {
                    <p class="cars-empty">Chưa có hãng xe nào.</p>
                }
            </div>
        </section>
    }
</div>

@if (!string.IsNullOrWhiteSpace(notice))
{
    <div class="cars-toast">
        @notice
        <button type="button" @onclick='() => notice = ""'>×</button>
    </div>
}

@* ===== Modal thêm / sửa ===== *@
@if (showModal)
{
    <div class="cars-modal-backdrop" @onclick="CloseModal">
        <div class="cars-modal" @onclick:stopPropagation="true">
            <div class="cars-modal-header">
                <div>
                    <h2>@(editingId == null ? "Thêm xe mới" : "Cập nhật xe")</h2>
                    <p>Nhập thông tin phương tiện vào hệ thống.</p>
                </div>
                <button type="button" @onclick="CloseModal">×</button>
            </div>

            <EditForm Model="form" OnValidSubmit="SaveCar">
                <DataAnnotationsValidator />

                <div class="cars-modal-grid">
                    <div class="cars-modal-field">
                        <label>Tên xe *</label>
                        <InputText class="cars-modal-input" @bind-Value="form.Name" placeholder="Ví dụ: Honda City RS" />
                        <ValidationMessage For="() => form.Name" />
                    </div>
                    <div class="cars-modal-field">
                        <label>Biển số *</label>
                        <InputText class="cars-modal-input" @bind-Value="form.LicensePlate" placeholder="51A-123.45" />
                        <ValidationMessage For="() => form.LicensePlate" />
                    </div>
                    <div class="cars-modal-field">
                        <label>Hãng xe *</label>
                        <InputSelect class="cars-modal-input" @bind-Value="form.BrandId">
                            <option value="@Guid.Empty">-- Chọn hãng --</option>
                            @foreach (var b in brands) { <option value="@b.Id">@b.Name</option> }
                        </InputSelect>
                        <ValidationMessage For="() => form.BrandId" />
                    </div>
                    <div class="cars-modal-field">
                        <label>Loại xe *</label>
                        <InputSelect class="cars-modal-input" @bind-Value="form.CategoryId">
                            <option value="@Guid.Empty">-- Chọn loại --</option>
                            @foreach (var c in categories) { <option value="@c.Id">@c.Name</option> }
                        </InputSelect>
                        <ValidationMessage For="() => form.CategoryId" />
                    </div>
                    <div class="cars-modal-field">
                        <label>Năm sản xuất *</label>
                        <InputNumber class="cars-modal-input" @bind-Value="form.ManufactureYear" />
                        <ValidationMessage For="() => form.ManufactureYear" />
                    </div>
                    <div class="cars-modal-field">
                        <label>Màu sắc</label>
                        <InputText class="cars-modal-input" @bind-Value="form.Color" />
                    </div>
                    <div class="cars-modal-field">
                        <label>Số chỗ *</label>
                        <InputNumber class="cars-modal-input" @bind-Value="form.Seats" />
                        <ValidationMessage For="() => form.Seats" />
                    </div>
                    <div class="cars-modal-field">
                        <label>Số km</label>
                        <InputNumber class="cars-modal-input" @bind-Value="form.Mileage" />
                        <ValidationMessage For="() => form.Mileage" />
                    </div>
                    <div class="cars-modal-field">
                        <label>Giá thuê / ngày (₫) *</label>
                        <InputNumber class="cars-modal-input" @bind-Value="form.PricePerDay" />
                        <ValidationMessage For="() => form.PricePerDay" />
                    </div>
                    <div class="cars-modal-field">
                        <label>Trạng thái</label>
                        <InputSelect class="cars-modal-input" @bind-Value="form.Status">
                            @foreach (var s in StatusMap) { <option value="@s.Key">@s.Value.Label</option> }
                        </InputSelect>
                    </div>

                    <div class="cars-modal-field cars-image-field">
                        <label>Ảnh phương tiện</label>
                        <InputFile class="cars-file-input" accept="image/*" OnChange="OnImageSelected" />
                        @if (!string.IsNullOrEmpty(imagePreview))
                        {
                            <div class="cars-image-preview">
                                <img src="@imagePreview" alt="Ảnh xe xem trước" />
                                <button type="button" class="cars-remove-image" @onclick="RemoveImage">×</button>
                            </div>
                        }
                        else
                        {
                            <div class="cars-upload-placeholder">
                                <span>＋</span><strong>Chọn ảnh xe</strong><small>PNG, JPG hoặc WEBP</small>
                            </div>
                        }
                    </div>
                </div>

                <div class="cars-modal-footer">
                    <button type="button" class="cars-cancel-button" @onclick="CloseModal" disabled="@saving">Hủy</button>
                    <button type="submit" class="cars-primary-button" disabled="@saving">
                        @(saving ? "Đang lưu..." : editingId == null ? "Thêm xe" : "Lưu thay đổi")
                    </button>
                </div>
            </EditForm>
        </div>
    </div>
}

@* ===== Modal xác nhận xóa ===== *@
@if (carToDelete != null)
{
    <div class="cars-modal-backdrop" @onclick="() => carToDelete = null">
        <div class="cars-modal" @onclick:stopPropagation="true">
            <div class="cars-modal-header">
                <div>
                    <h2>Ngừng hoạt động xe?</h2>
                    <p>@carToDelete.Name (@carToDelete.LicensePlate) sẽ chuyển sang trạng thái "Ngừng hoạt động".</p>
                </div>
            </div>
            <div class="cars-modal-footer">
                <button type="button" class="cars-cancel-button" @onclick="() => carToDelete = null">Hủy</button>
                <button type="button" class="cars-primary-button" @onclick="ConfirmDelete" disabled="@saving">Xác nhận</button>
            </div>
        </div>
    </div>
}

@* ===== Modal thêm / sửa hãng xe, loại xe ===== *@
@if (showCatalogModal)
{
    <div class="cars-modal-backdrop" @onclick="() => showCatalogModal = false">
        <div class="cars-modal" @onclick:stopPropagation="true">
            <div class="cars-modal-header">
                <div>
                    <h2>@(catalogEditingId == null ? "Thêm" : "Cập nhật") @CatalogTitle</h2>
                </div>
                <button type="button" @onclick="() => showCatalogModal = false">×</button>
            </div>

            <div class="cars-modal-grid">
                <div class="cars-modal-field">
                    <label>Tên @CatalogTitle *</label>
                    <input class="cars-modal-input" @bind="catalogName" @bind:event="oninput" />
                </div>
                <div class="cars-modal-field">
                    <label>@(catalogKind == "brand" ? "Quốc gia" : "Mô tả")</label>
                    <input class="cars-modal-input" @bind="catalogExtra" @bind:event="oninput" />
                </div>
            </div>

            @if (!string.IsNullOrEmpty(catalogError))
            {
                <p style="color:#d33;margin:8px 0 0">@catalogError</p>
            }

            <div class="cars-modal-footer">
                <button type="button" class="cars-cancel-button" @onclick="() => showCatalogModal = false" disabled="@saving">Hủy</button>
                <button type="button" class="cars-primary-button" @onclick="SaveCatalog" disabled="@saving">
                    @(saving ? "Đang lưu..." : "Lưu")
                </button>
            </div>
        </div>
    </div>
}

@if (catalogToDelete != null)
{
    <div class="cars-modal-backdrop" @onclick="() => catalogToDelete = null">
        <div class="cars-modal" @onclick:stopPropagation="true">
            <div class="cars-modal-header">
                <div>
                    <h2>Xóa @(catalogToDelete.Value.Kind == "brand" ? "hãng xe" : "loại xe")?</h2>
                    <p>"@catalogToDelete.Value.Name" sẽ bị xóa. Chỉ xóa được khi chưa có xe nào thuộc mục này.</p>
                </div>
            </div>
            <div class="cars-modal-footer">
                <button type="button" class="cars-cancel-button" @onclick="() => catalogToDelete = null">Hủy</button>
                <button type="button" class="cars-primary-button" @onclick="ConfirmDeleteCatalog" disabled="@saving">Xác nhận</button>
            </div>
        </div>
    </div>
}

@code {
    private const int PageSize = 8;

    private static readonly Dictionary<string, (string Label, string Css)> StatusMap = new()
    {
        ["Available"] = ("Sẵn sàng", "available"),
        ["Rented"] = ("Đang cho thuê", "renting"),
        ["Maintenance"] = ("Bảo trì", "maintenance"),
        ["Inactive"] = ("Ngừng hoạt động", "broken"),
    };

    private static (string Label, string Css) StatusInfo(string s) =>
        StatusMap.TryGetValue(s, out var v) ? v : (s, "");

    private string activeTab = "list";
    private string searchText = "";
    private string selectedBrandId = "";
    private string selectedStatus = "";
    private string notice = "";
    private bool loading, saving, showModal;
    private int currentPage = 1, total;

    private List<CarListItem> cars = new();
    private List<BrandItem> brands = new();
    private List<CategoryItem> categories = new();

    private Guid? editingId;
    private CarForm form = new();
    private CarListItem? carToDelete;
    private string? imagePreview;   // data URI (hiển thị + gửi lên API)

    private int TotalPages => Math.Max(1, (int)Math.Ceiling(total / (double)PageSize));

    protected override async Task OnInitializedAsync()
    {
        try
        {
            brands = await Http.GetFromJsonAsync<List<BrandItem>>("car-brands") ?? new();
            categories = await Http.GetFromJsonAsync<List<CategoryItem>>("car-categories") ?? new();
        }
        catch (Exception ex) { notice = "Không tải được hãng/loại xe: " + ex.Message; }
        await LoadCarsAsync();
    }

    // ---------- Đọc dữ liệu ----------
    private async Task LoadCarsAsync()
    {
        loading = true;
        try
        {
            var qs = new List<string> { $"page={currentPage}", $"pageSize={PageSize}" };
            if (!string.IsNullOrWhiteSpace(searchText)) qs.Add("keyword=" + Uri.EscapeDataString(searchText.Trim()));
            if (Guid.TryParse(selectedBrandId, out var bid)) qs.Add("brandId=" + bid);
            if (!string.IsNullOrEmpty(selectedStatus)) qs.Add("status=" + selectedStatus);

            var res = await Http.GetFromJsonAsync<PagedResult>("cars?" + string.Join("&", qs));
            cars = res?.Items ?? new();
            total = res?.Total ?? 0;
        }
        catch (Exception ex) { notice = "Không tải được danh sách xe: " + ex.Message; }
        finally { loading = false; }
    }

    private async Task ApplyFilter() { currentPage = 1; await LoadCarsAsync(); }

    private async Task ClearFilters()
    {
        searchText = ""; selectedBrandId = ""; selectedStatus = "";
        await ApplyFilter();
    }

    private async Task GoToPage(int page)
    {
        if (page < 1 || page > TotalPages) return;
        currentPage = page;
        await LoadCarsAsync();
    }

    private async Task ShowCarsOfBrand(Guid brandId)
    {
        selectedBrandId = brandId.ToString();
        selectedStatus = ""; searchText = "";
        activeTab = "list";
        await ApplyFilter();
    }

    // ---------- Thêm / sửa ----------
    private void OpenAddModal()
    {
        editingId = null;
        form = new CarForm();
        imagePreview = null;
        showModal = true;
    }

    private void OpenEditModal(CarListItem c)
    {
        editingId = c.Id;
        form = new CarForm
        {
            Name = c.Name, LicensePlate = c.LicensePlate, ManufactureYear = c.ManufactureYear,
            PricePerDay = c.PricePerDay, Color = c.Color, Seats = c.Seats, Mileage = c.Mileage,
            Status = c.Status, BrandId = c.BrandId, CategoryId = c.CategoryId
        };
        imagePreview = null;   // chỉ có giá trị khi người dùng chọn ảnh mới
        showModal = true;
    }

    private void CloseModal() { showModal = false; imagePreview = null; }

    private async Task SaveCar()
    {
        saving = true;
        try
        {
            HttpResponseMessage resp;
            Guid carId;

            if (editingId == null)
            {
                resp = await Http.PostAsJsonAsync("cars", form);
                if (!resp.IsSuccessStatusCode) { notice = await ReadError(resp); return; }
                var created = await resp.Content.ReadFromJsonAsync<CreatedResult>();
                carId = created!.Id;
            }
            else
            {
                carId = editingId.Value;
                resp = await Http.PutAsJsonAsync($"cars/{carId}", form);
                if (!resp.IsSuccessStatusCode) { notice = await ReadError(resp); return; }
            }

            if (!string.IsNullOrEmpty(imagePreview))
            {
                var imgResp = await Http.PostAsJsonAsync($"cars/{carId}/images",
                    new { url = imagePreview, isPrimary = true });
                if (!imgResp.IsSuccessStatusCode)
                {
                    notice = "Đã lưu xe nhưng thêm ảnh lỗi: " + await ReadError(imgResp);
                    showModal = false;
                    await LoadCarsAsync();
                    return;
                }
            }

            notice = editingId == null ? "Đã thêm xe mới." : "Đã cập nhật xe.";
            showModal = false;
            imagePreview = null;
            await LoadCarsAsync();
        }
        catch (Exception ex) { notice = "Lỗi kết nối API: " + ex.Message; }
        finally { saving = false; }
    }

    // ---------- Xóa (mềm) ----------
    private void AskDelete(CarListItem c) => carToDelete = c;

    private async Task ConfirmDelete()
    {
        if (carToDelete == null) return;
        saving = true;
        try
        {
            var resp = await Http.DeleteAsync($"cars/{carToDelete.Id}");
            notice = resp.IsSuccessStatusCode
                ? $"Đã chuyển {carToDelete.Name} sang ngừng hoạt động."
                : await ReadError(resp);   // vd: 409 xe đang có đơn thuê
            carToDelete = null;
            await LoadCarsAsync();
        }
        catch (Exception ex) { notice = "Lỗi kết nối API: " + ex.Message; }
        finally { saving = false; }
    }

    // ---------- Hãng xe / Loại xe ----------
    private bool showCatalogModal;
    private string catalogKind = "brand";
    private Guid? catalogEditingId;
    private string catalogName = "";
    private string catalogExtra = "";
    private string catalogError = "";
    private (string Kind, Guid Id, string Name)? catalogToDelete;

    private string CatalogTitle => catalogKind == "brand" ? "hãng xe" : "loại xe";
    private string CatalogRoute => catalogKind == "brand" ? "car-brands" : "car-categories";

    private async Task ReloadCatalogsAsync()
    {
        brands = await Http.GetFromJsonAsync<List<BrandItem>>("car-brands") ?? new();
        categories = await Http.GetFromJsonAsync<List<CategoryItem>>("car-categories") ?? new();
    }

    private void OpenCatalogModal(string kind, Guid? id)
    {
        catalogKind = kind;
        catalogEditingId = id;
        catalogError = "";
        catalogName = ""; catalogExtra = "";

        if (id != null && kind == "brand")
        {
            var b = brands.First(x => x.Id == id);
            catalogName = b.Name; catalogExtra = b.Country ?? "";
        }
        else if (id != null)
        {
            var c = categories.First(x => x.Id == id);
            catalogName = c.Name; catalogExtra = c.Description ?? "";
        }
        showCatalogModal = true;
    }

    private async Task SaveCatalog()
    {
        if (string.IsNullOrWhiteSpace(catalogName)) { catalogError = "Tên không được trống."; return; }

        saving = true; catalogError = "";
        try
        {
            object body = catalogKind == "brand"
                ? new { name = catalogName.Trim(), country = catalogExtra.Trim() }
                : new { name = catalogName.Trim(), description = catalogExtra.Trim() };

            var resp = catalogEditingId == null
                ? await Http.PostAsJsonAsync(CatalogRoute, body)
                : await Http.PutAsJsonAsync($"{CatalogRoute}/{catalogEditingId}", body);

            if (!resp.IsSuccessStatusCode) { catalogError = await ReadError(resp); return; }

            notice = catalogEditingId == null ? $"Đã thêm {CatalogTitle}." : $"Đã cập nhật {CatalogTitle}.";
            showCatalogModal = false;
            await ReloadCatalogsAsync();
            await LoadCarsAsync();   // tên hãng/loại hiển thị trong bảng xe
        }
        catch (Exception ex) { catalogError = "Lỗi kết nối API: " + ex.Message; }
        finally { saving = false; }
    }

    private void AskDeleteCatalog(string kind, Guid id, string name) => catalogToDelete = (kind, id, name);

    private async Task ConfirmDeleteCatalog()
    {
        if (catalogToDelete == null) return;
        var (kind, id, name) = catalogToDelete.Value;
        saving = true;
        try
        {
            var route = kind == "brand" ? "car-brands" : "car-categories";
            var resp = await Http.DeleteAsync($"{route}/{id}");
            if (resp.IsSuccessStatusCode)
            {
                notice = $"Đã xóa \"{name}\".";
                if (selectedBrandId == id.ToString()) selectedBrandId = "";
                await ReloadCatalogsAsync();
                await LoadCarsAsync();
            }
            else notice = await ReadError(resp);   // vd: 409 đang có xe
            catalogToDelete = null;
        }
        catch (Exception ex) { notice = "Lỗi kết nối API: " + ex.Message; }
        finally { saving = false; }
    }

    // ---------- Ảnh ----------
    private async Task OnImageSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        var allowed = new[] { "image/jpeg", "image/png", "image/webp" };
        if (!allowed.Contains(file.ContentType)) { notice = "Vui lòng chọn ảnh JPG, PNG hoặc WEBP."; return; }
        if (file.Size > 5 * 1024 * 1024) { notice = "Ảnh không được vượt quá 5MB."; return; }

        using var stream = file.OpenReadStream(5 * 1024 * 1024);
        using var ms = new MemoryStream();
        await stream.CopyToAsync(ms);
        imagePreview = $"data:{file.ContentType};base64,{Convert.ToBase64String(ms.ToArray())}";
    }

    private void RemoveImage() => imagePreview = null;

    // ---------- Helpers & models ----------
    private static async Task<string> ReadError(HttpResponseMessage resp)
    {
        try
        {
            var err = await resp.Content.ReadFromJsonAsync<ApiError>();
            if (!string.IsNullOrWhiteSpace(err?.Message)) return err.Message!;
        }
        catch { }
        return $"Lỗi {(int)resp.StatusCode} {resp.ReasonPhrase}";
    }

    private sealed record ApiError(string? Message);
    private sealed record CreatedResult(Guid Id);
    private sealed record PagedResult(List<CarListItem> Items, int Total, int Page, int PageSize);
    private sealed record BrandItem(Guid Id, string Name, string? Country, int CarCount);
    private sealed record CategoryItem(Guid Id, string Name, string? Description, int CarCount);

    private sealed record CarListItem(
        Guid Id, string Name, string LicensePlate, int ManufactureYear, decimal PricePerDay,
        string Color, int Seats, int Mileage, string Status,
        Guid BrandId, string BrandName, Guid CategoryId, string CategoryName,
        string? PrimaryImage, double? AverageRating);

    private sealed class CarForm
    {
        [Required(ErrorMessage = "Vui lòng nhập tên xe.")]
        public string Name { get; set; } = "";

        [Required(ErrorMessage = "Vui lòng nhập biển số.")]
        public string LicensePlate { get; set; } = "";

        [Range(1990, 2100, ErrorMessage = "Năm sản xuất không hợp lệ.")]
        public int ManufactureYear { get; set; } = DateTime.Now.Year;

        [Range(1, double.MaxValue, ErrorMessage = "Giá thuê phải lớn hơn 0.")]
        public decimal PricePerDay { get; set; }

        public string Color { get; set; } = "";

        [Range(1, 60, ErrorMessage = "Số chỗ phải lớn hơn 0.")]
        public int Seats { get; set; } = 4;

        [Range(0, int.MaxValue, ErrorMessage = "Số km không hợp lệ.")]
        public int Mileage { get; set; }

        public string Status { get; set; } = "Available";

        [Range(typeof(Guid), "00000000-0000-0000-0000-000000000001", "ffffffff-ffff-ffff-ffff-ffffffffffff",
            ErrorMessage = "Vui lòng chọn hãng xe.")]
        public Guid BrandId { get; set; }

        [Range(typeof(Guid), "00000000-0000-0000-0000-000000000001", "ffffffff-ffff-ffff-ffff-ffffffffffff",
            ErrorMessage = "Vui lòng chọn loại xe.")]
        public Guid CategoryId { get; set; }
    }
}
