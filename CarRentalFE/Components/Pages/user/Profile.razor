@page "/user/profile"
@rendermode InteractiveServer
@using System.Linq
@using CarRentalFE.Components.Layout
@layout EmptyLayout

@using CarRentalFE.Services
@inject AuthService AuthService
@inject CarApiService Api
@inject IConfiguration Configuration
@inject NavigationManager Navigation

<PageTitle>Đơn thuê của tôi - RENTO</PageTitle>

<div class="rento-app">
    <header class="rento-header">
        <a href="/" class="rento-logo">
            <span class="logo-icon">🚘</span>
            <strong>RENTO</strong>
        </a>

        <nav class="rento-nav">
            <a href="/">Trang chủ</a>
            <a href="/user/cars">Thuê xe</a>
            <a href="/user/guide">Hướng dẫn thuê xe</a>
            <a href="/user/support">Hỗ trợ</a>
        </nav>

        <div class="header-user">
            <span class="avatar">NT</span>
            <div>
                <strong>Nguyễn Minh Tú</strong>
                <small>Tài khoản của tôi</small>
            </div>
            <span>⌄</span>
        </div>
    </header>

    <div class="rento-body">
        <aside class="rento-sidebar">
            <div class="sidebar-profile">
                <span class="avatar">NT</span>
                <div>
                    <strong>Nguyễn Minh Tú</strong>
                    <small>Thành viên Bạc</small>
                </div>
            </div>

            <nav class="sidebar-menu">
                <a href="/user/dashboard">▦ &nbsp; Tổng quan tài khoản</a>
                <a href="/user/profile" class="active">🚘 &nbsp; Đơn thuê của tôi</a>
                <a href="/user/contracts">▤ &nbsp; Hợp đồng</a>
                <a href="/user/payments">▣ &nbsp; Thanh toán</a>
                <a href="/user/reviews">☆ &nbsp; Đánh giá của tôi</a>
                <a href="/user/support">ⓘ &nbsp; Yêu cầu hỗ trợ</a>
                <a href="/user/notifications">♧ &nbsp; Thông báo</a>
                <a href="/user/account-info">♙ &nbsp; Thông tin cá nhân</a>
            </nav>

            <a href="javascript:void(0)" class="sidebar-logout" @onclick="Logout">
                ⇥ &nbsp; Đăng xuất
            </a>
        </aside>

        <main class="rentals-main">
            <h1>Đơn thuê của tôi</h1>
            <p class="page-subtitle">
                Theo dõi và quản lý mọi hành trình.
            </p>

            <div class="rento-stats">
                <div class="user-stat-card">
                    <span class="user-stat-icon">
                        <svg viewBox="0 0 24 24">
                            <rect x="5" y="3" width="14" height="18" rx="2" />
                            <path d="M8 8h8M8 12h8M8 16h5" />
                        </svg>
                    </span>
                    <div>
                        <small>Tổng đơn thuê</small>
                        <strong>@Bookings.Count.ToString("00")</strong>
                    </div>
                </div>

                <div class="user-stat-card">
                    <span class="user-stat-icon">
                        <svg viewBox="0 0 24 24">
                            <path d="M3 13l2-6h14l2 6" />
                            <path d="M3 13h18v5H3z" />
                            <path d="M6 18v2M18 18v2" />
                            <circle cx="7" cy="15.5" r="1" />
                            <circle cx="17" cy="15.5" r="1" />
                        </svg>
                    </span>
                    <div>
                        <small>Đang thuê</small>
                        <strong>@Bookings.Count(b => b.Status == "Đang thuê").ToString("00")</strong>
                    </div>
                </div>

                <div class="user-stat-card">
                    <span class="user-stat-icon">
                        <svg viewBox="0 0 24 24">
                            <circle cx="12" cy="12" r="9" />
                            <path d="M12 7v5l3 2" />
                        </svg>
                    </span>
                    <div>
                        <small>Chờ xác nhận</small>
                        <strong>@Bookings.Count(b => b.Status == "Chờ xác nhận").ToString("00")</strong>
                    </div>
                </div>

                <div class="user-stat-card">
                    <span class="user-stat-icon">
                        <svg viewBox="0 0 24 24">
                            <path d="M3 17l6-6 4 4 8-9" />
                            <path d="M15 6h6v6" />
                            <path d="M4 21h16" />
                        </svg>
                    </span>
                    <div>
                        <small>Tổng hành trình</small>
                        <strong>2.840 km</strong>
                    </div>
                </div>
            </div>

            <div class="rento-tabs">
                @foreach (var tab in StatusTabs)
                {
                    <button class="@(SelectedStatus == tab ? "active" : "")" @onclick="() => SelectStatus(tab)">@tab</button>
                }
            </div>

            <div class="rento-toolbar">
                <input type="text" placeholder="⌕  Tìm theo mã đơn hoặc tên xe" @bind="SearchText"
                    @bind:event="oninput" />

                <button class="date-filter" @onclick="ToggleDateFilter">
                    ▣ &nbsp; Lọc theo ngày
                </button>
            </div>

            @if (ShowDateFilter)
            {
                <div class="date-filter-panel">
                    <label>Từ ngày
                        <input type="date" @bind="FromDate" />
                    </label>
                    <label>Đến ngày
                        <input type="date" @bind="ToDate" />
                    </label>
                    <button @onclick="ClearDates">Xóa lọc ngày</button>
                </div>
            }

            <div class="booking-list">
                @if (loading)
                {
                    <div class="empty-bookings">Đang tải đơn thuê...</div>
                }
                else if (!string.IsNullOrEmpty(error))
                {
                    <div class="empty-bookings">@error</div>
                }

                @foreach (var booking in FilteredBookings)
                {
                    <div class="booking-card">
                        @if (!string.IsNullOrWhiteSpace(booking.Image))
                        {
                            <img src="@booking.Image" alt="@booking.CarName" />
                        }
                        else
                        {
                            <div class="no-image">🚘</div>
                        }

                        <div class="booking-info">
                            <div class="booking-meta">
                                <span>@booking.Id</span>
                                <span class="status-badge @booking.StatusClass">
                                    @booking.Status
                                </span>
                            </div>

                            <h3>@booking.CarName</h3>
                            <p>▣ &nbsp; @booking.DateText</p>
                        </div>

                        <div class="booking-actions">
                            <small>Tổng dự kiến</small>
                            <strong>@booking.Price.ToString("N0") ₫</strong>
                            <button @onclick="() => ShowBooking(booking)">
                                Xem chi tiết
                            </button>
                        </div>
                    </div>
                }

                @if (!loading && string.IsNullOrEmpty(error) && !FilteredBookings.Any())
                {
                    <div class="empty-bookings">
                        Không tìm thấy đơn thuê phù hợp.
                    </div>
                }
            </div>
        </main>
    </div>
</div>

@if (SelectedBooking is not null)
{
    <div class="rento-modal-backdrop">
        <div class="rento-modal">
            <h2>Chi tiết đơn thuê</h2>
            <p><b>Mã đơn:</b> @SelectedBooking.Id</p>
            <p><b>Xe:</b> @SelectedBooking.CarName</p>
            <p><b>Thời gian:</b> @SelectedBooking.DateText</p>
            <p><b>Trạng thái:</b> @SelectedBooking.Status</p>
            <p><b>Tổng dự kiến:</b> @SelectedBooking.Price.ToString("N0") ₫</p>
            <button @onclick="CloseBooking">Đóng</button>
        </div>
    </div>
}

@code {
    private string SelectedStatus = "Tất cả";
    private string SearchText = "";
    private bool ShowDateFilter = false;
    private DateTime? FromDate;
    private DateTime? ToDate;
    private BookingItem? SelectedBooking;

    private bool loading = true;
    private string? error;
    private List<BookingItem> Bookings = new();

    private readonly string[] StatusTabs =
    {
        "Tất cả", "Chờ xác nhận", "Sắp nhận xe",
        "Đang thuê", "Hoàn thành", "Đã hủy"
    };

    // ProtectedLocalStorage chỉ dùng được sau khi render xong
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await LoadBookingsAsync();
        loading = false;
        StateHasChanged();
    }

    private async Task LoadBookingsAsync()
    {
        try
        {
            var customerId = await AuthService.GetCurrentUserIdAsync();
            if (customerId == null)
            {
                Navigation.NavigateTo("/login", forceLoad: true);
                return;
            }

            var data = await Api.GetMyBookingsAsync(customerId.Value);
            Bookings = data.Select(b =>
            {
                var (text, css) = StatusInfo(b.Status);
                return new BookingItem
                {
                    Id = "#" + b.Id.ToString("N")[..8].ToUpper(),
                    CarId = b.CarId.ToString(),
                    CarName = b.CarName,
                    DateText = $"{b.PickupDate:dd/MM/yyyy} – {b.ReturnDate:dd/MM/yyyy}",
                    StartDate = b.PickupDate,
                    Price = b.TotalAmount,
                    Status = text,
                    StatusClass = css,
                    Image = ImageUrl(b.PrimaryImage)
                };
            }).ToList();
        }
        catch (Exception ex)
        {
            error = "Không tải được đơn thuê: " + ex.Message;
        }
    }

    private static (string Text, string Css) StatusInfo(string s) => s switch
    {
        "Pending" => ("Chờ xác nhận", "pending"),
        "Confirmed" => ("Sắp nhận xe", "upcoming"),
        "Active" or "Renting" or "InProgress" => ("Đang thuê", "renting"),
        "Completed" => ("Hoàn thành", "completed"),
        "Cancelled" => ("Đã hủy", "cancelled"),
        _ => (s, "")
    };

    private string ImageUrl(string? path)
    {
        if (string.IsNullOrWhiteSpace(path)) return "";
        if (path.StartsWith("data:")) return path;               // ảnh lưu dạng base64
        if (Uri.TryCreate(path, UriKind.Absolute, out var abs)) return abs.ToString();
        var baseUrl = Configuration["Api:BaseUrl"] ?? "http://localhost:5110/";
        return new Uri(new Uri(baseUrl), path.TrimStart('/')).ToString();
    }

    private IEnumerable<BookingItem> FilteredBookings =>
        Bookings.Where(b =>
            (SelectedStatus == "Tất cả" || b.Status == SelectedStatus)
            && (string.IsNullOrWhiteSpace(SearchText)
                || b.Id.Contains(SearchText, StringComparison.OrdinalIgnoreCase)
                || b.CarName.Contains(SearchText, StringComparison.OrdinalIgnoreCase))
            && (!FromDate.HasValue || b.StartDate.Date >= FromDate.Value.Date)
            && (!ToDate.HasValue || b.StartDate.Date <= ToDate.Value.Date));

    private void SelectStatus(string status) => SelectedStatus = status;
    private void ToggleDateFilter() => ShowDateFilter = !ShowDateFilter;
    private void ClearDates() { FromDate = null; ToDate = null; }
    private void ShowBooking(BookingItem booking) => SelectedBooking = booking;
    private void CloseBooking() => SelectedBooking = null;

    private class BookingItem
    {
        public string Id { get; set; } = "";
        public string CarName { get; set; } = "";
        public string CarId { get; set; } = "";
        public string DateText { get; set; } = "";
        public DateTime StartDate { get; set; }
        public decimal Price { get; set; }
        public string Status { get; set; } = "";
        public string StatusClass { get; set; } = "";
        public string Image { get; set; } = "";
    }

    private async Task Logout()
    {
        // Xóa JWT Token và thông tin người dùng
        await AuthService.LogoutAsync();

        // Chuyển về trang đăng nhập và tải lại ứng dụng
        Navigation.NavigateTo("/login", forceLoad: true);
    }
}
