@inherits LayoutComponentBase
@using Microsoft.AspNetCore.Components

<div class="admin-shell">
    <aside class="admin-sidebar @(sidebarCollapsed ? "is-collapsed" : "")">
        <div class="admin-brand">
            <div class="admin-brand-mark">R</div>
            <div class="admin-brand-copy">
                <strong>RENTO</strong>
                <span>CAR RENTAL SYSTEM</span>
            </div>
            <button class="sidebar-toggle" type="button" title="Thu gọn menu" @onclick="ToggleSidebar">
                <span>☰</span>
            </button>
        </div>

        <nav class="admin-nav">
            <div class="nav-caption">TỔNG QUAN</div>
            <a class="admin-nav-link active" href="/admin/dashboard">
                <span class="nav-icon">▦</span><span class="nav-text">Bảng điều khiển</span>
            </a>

            <div class="nav-caption">QUẢN LÝ</div>
            <a class="admin-nav-link" href="/admin/account-info"><span class="nav-icon">♙</span><span class="nav-text">Tài khoản</span></a>
            <a class="admin-nav-link" href="/admin/cars"><span class="nav-icon">▣</span><span class="nav-text">Quản lý xe</span><span class="nav-count">128</span></a>
            <a class="admin-nav-link" href="/admin/rentals"><span class="nav-icon">▤</span><span class="nav-text">Đơn thuê xe</span><span class="nav-count">12</span></a>
            <a class="admin-nav-link" href="/admin/contracts"><span class="nav-icon">▧</span><span class="nav-text">Trả xe & Hợp đồng</span></a>
            <a class="admin-nav-link" href="/admin/payments"><span class="nav-icon">▱</span><span class="nav-text">Thanh toán</span></a>

            <div class="nav-caption">KHÁCH HÀNG</div>
            <a class="admin-nav-link" href="/admin/customers"><span class="nav-icon">♙</span><span class="nav-text">Hồ sơ khách hàng</span></a>
            <a class="admin-nav-link" href="/admin/support"><span class="nav-icon">♧</span><span class="nav-text">Hỗ trợ</span><span class="nav-dot"></span></a>
            <a class="admin-nav-link" href="/admin/reviews"><span class="nav-icon">☆</span><span class="nav-text">Đánh giá</span></a>
            <a class="admin-nav-link" href="/admin/notifications"><span class="nav-icon">♧</span><span class="nav-text">Thông báo</span><span class="nav-count">6</span></a>
        </nav>

        <div class="admin-sidebar-bottom">
            <a href="/login" class="sidebar-logout"><span class="nav-icon">⇥</span><span class="nav-text">Đăng xuất</span></a>
        </div>
    </aside>

    <main class="admin-main">
        <header class="admin-topbar">
            <div class="admin-breadcrumb"><span>RENTO</span><b>›</b><strong>Bảng điều khiển</strong></div>
            <div class="admin-top-actions">
                <label class="admin-search">
                    <span>⌕</span>
                    <input placeholder="Tìm kiếm đơn thuê, khách hàng..." />
                    <kbd>⌘ K</kbd>
                </label>
                <button class="top-icon-button" type="button" title="Thông báo">♧<i></i></button>
                <button class="admin-user-button" type="button">
                    <span class="admin-avatar">HM</span>
                    <span class="admin-user-copy"><strong>Hoàng Minh</strong><small>Quản trị viên</small></span>
                    <span class="user-chevron">⌄</span>
                </button>
            </div>
        </header>

        <section class="admin-page-content">
            @Body
        </section>
    </main>
</div>

@code {
    private bool sidebarCollapsed;

    private void ToggleSidebar()
    {
        sidebarCollapsed = !sidebarCollapsed;
    }
}
