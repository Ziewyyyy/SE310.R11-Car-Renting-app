@page "/admin/dashboard"
@layout AdminLayout
@using System.Globalization

<PageTitle>Bảng điều khiển | RENTO</PageTitle>

<div class="dashboard-heading">
    <div>
        <div class="eyebrow">PHÂN TÍCH KINH DOANH</div>
        <h1>Tổng quan vận hành</h1>
        <p>Theo dõi hiệu suất kinh doanh và đội xe theo thời gian thực.</p>
    </div>
    <div class="dashboard-heading-actions">
        <select class="date-select" @bind="selectedRange">
            <option>30 ngày qua</option>
            <option>7 ngày qua</option>
            <option>Hôm nay</option>
            <option>90 ngày qua</option>
        </select>
        <button class="primary-action" type="button" @onclick="ShowExportNotice">↓ &nbsp; Xuất báo cáo</button>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(notice))
{
    <div class="dashboard-notice">@notice</div>
}

<div class="stats-grid">
    <article class="stat-card">
        <div class="stat-card-top"><span>Doanh thu tháng</span><span class="stat-icon cyan">▱</span></div>
        <strong class="stat-value">428,6 triệu ₫</strong>
        <div class="stat-change positive">↑ 12,4% <span>so với tháng trước</span></div>
    </article>
    <article class="stat-card">
        <div class="stat-card-top"><span>Đơn thuê mới</span><span class="stat-icon blue">▣</span></div>
        <strong class="stat-value">86</strong>
        <div class="stat-change positive">↑ 8,2% <span>18 đơn trong tuần</span></div>
    </article>
    <article class="stat-card">
        <div class="stat-card-top"><span>Xe đang cho thuê</span><span class="stat-icon green">▣</span></div>
        <strong class="stat-value">54</strong>
        <div class="stat-change positive">↑ 4,1% <span>42,2% tổng đội xe</span></div>
    </article>
    <article class="stat-card">
        <div class="stat-card-top"><span>Đơn chờ xử lý</span><span class="stat-icon orange">◷</span></div>
        <strong class="stat-value">12</strong>
        <div class="stat-change negative">↓ 3 <span>cần xác nhận hôm nay</span></div>
    </article>
</div>

<div class="dashboard-middle-grid">
    <section class="panel revenue-panel">
        <div class="panel-heading">
            <div><h2>Doanh thu 7 ngày gần nhất</h2><p>Doanh thu nhận từ đơn thuê hoàn thành</p></div>
            <div class="chart-legend"><span><i></i> Doanh thu</span><span class="muted-legend">Mục tiêu</span></div>
        </div>
        <div class="revenue-summary"><strong>358.400.000 ₫</strong><span>↑ 9,8%</span></div>
        <div class="revenue-chart">
            <div class="chart-y-labels"><span>80tr</span><span>60tr</span><span>40tr</span><span>20tr</span><span>0</span></div>
            <svg viewBox="0 0 900 210" preserveAspectRatio="none" role="img" aria-label="Biểu đồ doanh thu 7 ngày">
                <defs>
                    <linearGradient id="revenueFill" x1="0" x2="0" y1="0" y2="1">
                        <stop offset="0%" stop-color="#08c9e8" stop-opacity=".25" />
                        <stop offset="100%" stop-color="#08c9e8" stop-opacity="0" />
                    </linearGradient>
                </defs>
                <g class="chart-grid-lines">
                    <line x1="0" y1="20" x2="900" y2="20" /><line x1="0" y1="62" x2="900" y2="62" />
                    <line x1="0" y1="104" x2="900" y2="104" /><line x1="0" y1="146" x2="900" y2="146" />
                    <line x1="0" y1="188" x2="900" y2="188" />
                </g>
                <path class="chart-area" d="M0,165 C45,160 65,145 110,145 S170,150 220,128 S290,112 335,120 S395,115 445,88 S500,95 555,92 S620,62 675,68 S735,74 780,48 S845,56 900,42 L900,188 L0,188 Z" />
                <path class="chart-line" d="M0,165 C45,160 65,145 110,145 S170,150 220,128 S290,112 335,120 S395,115 445,88 S500,95 555,92 S620,62 675,68 S735,74 780,48 S845,56 900,42" />
                <circle class="chart-point" cx="900" cy="42" r="4" />
            </svg>
            <div class="chart-x-labels"><span>23/07</span><span>24/07</span><span>25/07</span><span>26/07</span><span>27/07</span><span>28/07</span><span>29/07</span></div>
        </div>
    </section>

    <div class="right-panels">
        <section class="panel top-cars-panel">
            <div class="panel-heading"><div><h2>Xe được thuê nhiều nhất</h2><p>Thống kê lượt thuê tháng này</p></div></div>
            @foreach (var car in topCars)
            {
                <div class="car-stat">
                    <div class="car-stat-label"><span>@car.Name</span><small>@car.Count lượt</small></div>
                    <div class="car-progress"><span style="width:@(car.Percent)%"></span></div>
                </div>
            }
        </section>

        <section class="panel status-panel">
            <div><h2>Phân bổ trạng thái thuê</h2><p>248 đơn hàng tháng này</p></div>
            <div class="status-content">
                <div class="donut-chart"><div><strong>248</strong><small>Tổng đơn</small></div></div>
                <div class="status-legend">
                    <div><i class="legend-green"></i><span>Hoàn thành</span><b>48%</b></div>
                    <div><i class="legend-cyan"></i><span>Đang thuê</span><b>27%</b></div>
                    <div><i class="legend-blue"></i><span>Chờ xác nhận</span><b>17%</b></div>
                    <div><i class="legend-red"></i><span>Đã hủy</span><b>8%</b></div>
                </div>
            </div>
        </section>
    </div>
</div>

<div class="dashboard-bottom-grid">
    <section class="panel recent-orders-panel">
        <div class="panel-heading orders-heading">
            <div><h2>Đơn thuê gần đây</h2><p>Các đơn thuê mới nhất trong hệ thống</p></div>
            <div class="orders-tools">
                <input class="order-filter" placeholder="⌕  Tìm mã đơn..." @bind="searchText" />
                <a href="/admin/bookings">Xem tất cả ›</a>
            </div>
        </div>
        <div class="table-scroll">
            <table class="orders-table">
                <thead><tr><th>MÃ ĐƠN</th><th>KHÁCH HÀNG</th><th>XE THUÊ</th><th>THỜI GIAN</th><th>TỔNG TIỀN</th><th>TRẠNG THÁI</th><th></th></tr></thead>
                <tbody>
                    @foreach (var order in FilteredOrders)
                    {
                        <tr>
                            <td class="order-code">@order.Code</td>
                            <td><div class="customer-cell"><span class="customer-avatar">@order.Initials</span><strong>@order.Customer</strong></div></td>
                            <td><strong>@order.Car</strong><small class="table-subtext">@order.Plate</small></td>
                            <td>@order.Period</td>
                            <td class="money-cell">@order.Total</td>
                            <td><span class="order-status @order.StatusClass">@order.Status</span></td>
                            <td class="more-cell">···</td>
                        </tr>
                    }
                    @if (!FilteredOrders.Any())
                    {
                        <tr><td colspan="7" class="empty-row">Không tìm thấy đơn thuê phù hợp.</td></tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="table-footer"><span>Hiển thị @FilteredOrders.Count() trong @orders.Count đơn</span><div class="pagination"><button disabled>‹</button><button class="selected-page">1</button><button disabled>2</button><button disabled>3</button><button disabled>›</button></div></div>
    </section>

    <section class="panel activity-panel">
        <div class="panel-heading"><div><h2>Hoạt động gần đây</h2><p>Cập nhật mới nhất</p></div><button class="plain-more" type="button">···</button></div>
        <div class="activity-item"><span class="activity-icon activity-success">✓</span><div><strong>Đơn thuê đã được xác nhận</strong><p>RE-240728 · Nguyễn Minh Anh</p><small>◷ 5 phút trước</small></div></div>
        <div class="activity-item"><span class="activity-icon activity-blue">▣</span><div><strong>Nhận thanh toán mới</strong><p>5.000.000 ₫ · GD-240729</p><small>◷ 24 phút trước</small></div></div>
        <div class="activity-item"><span class="activity-icon activity-warning">△</span><div><strong>Xe sắp đến hạn bảo dưỡng</strong><p>Mazda CX-5 · 51A-123.45</p><small>◷ 1 giờ trước</small></div></div>
        <div class="activity-item"><span class="activity-icon activity-danger">♧</span><div><strong>Yêu cầu hỗ trợ mới</strong><p>TK-1027 · Khách cần tư vấn xe</p><small>◷ 2 giờ trước</small></div></div>
        <a class="activity-all-link" href="/admin/notifications">Xem tất cả hoạt động ›</a>
    </section>
</div>

@code {
    private string selectedRange = "30 ngày qua";
    private string searchText = "";
    private string notice = "";

    private IEnumerable<OrderRow> FilteredOrders =>
        orders.Where(o => string.IsNullOrWhiteSpace(searchText)
            || o.Code.Contains(searchText, StringComparison.OrdinalIgnoreCase)
            || o.Customer.Contains(searchText, StringComparison.OrdinalIgnoreCase));

    private readonly List<CarStat> topCars = new()
    {
        new("VinFast VF 8", 18, 92),
        new("Toyota Camry", 15, 76),
        new("Mercedes C200", 12, 58),
        new("Mazda CX-5", 9, 45)
    };

    private readonly List<OrderRow> orders = new()
    {
        new("RE-240728", "Nguyễn Minh Anh", "NA", "Mercedes-Benz C200", "51G-332.16", "28/07 – 02/08", "7.500.000 ₫", "Đang thuê", "status-renting"),
        new("RE-240727", "Trần Hoàng Nam", "TN", "VinFast VF 8 Plus", "51K-218.10", "27/07 – 30/07", "4.350.000 ₫", "Chờ xác nhận", "status-pending"),
        new("RE-240726", "Lê Thanh Huyền", "LH", "Mazda CX-5 Premium", "51A-123.45", "25/07 – 28/07", "3.800.000 ₫", "Hoàn thành", "status-completed"),
        new("RE-240725", "Phạm Đức Long", "PL", "Toyota Camry 2.5Q", "51H-456.78", "24/07 – 26/07", "6.250.000 ₫", "Đang thuê", "status-renting")
    };

    private void ShowExportNotice()
    {
        notice = "Giao diện xuất báo cáo đã được bố trí. Chức năng xuất dữ liệu thật sẽ được kết nối sau khi có API thống kê.";
    }

    private record CarStat(string Name, int Count, int Percent);
    private record OrderRow(string Code, string Customer, string Initials, string Car, string Plate, string Period, string Total, string Status, string StatusClass);
}
