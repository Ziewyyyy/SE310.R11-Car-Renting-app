    private IEnumerable<SupportTicket> filteredTickets =>
        (sortOrder == "newest"
            ? tickets.OrderByDescending(x => x.CreatedAt)
            : tickets.OrderBy(x => x.CreatedAt))
        .Where(x =>
            (string.IsNullOrWhiteSpace(searchText) ||
             x.Code.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
             x.Title.Contains(searchText, StringComparison.OrdinalIgnoreCase) ||
             x.Customer.Contains(searchText, StringComparison.OrdinalIgnoreCase)) &&
            (string.IsNullOrWhiteSpace(statusFilter) || x.Status == statusFilter) &&
            (string.IsNullOrWhiteSpace(priorityFilter) || x.Priority == priorityFilter));

    protected override void OnInitialized()
    {
        selectedTicket = tickets.FirstOrDefault();
    }

    private void SelectTicket(SupportTicket ticket)
    {
        selectedTicket = ticket;
        replyContent = "";
        replyError = "";
        attachmentName = "";
    }

    private void ToggleFilter()
    {
        showFilter = !showFilter;
    }

    private void ChangeReplyMode(string mode)
    {
        replyMode = mode;
        replyContent = "";
        replyError = "";
    }

    private void SendReply()
    {
        if (selectedTicket is null)
            return;

        if (string.IsNullOrWhiteSpace(replyContent))
        {
            replyError = "Vui lòng nhập nội dung trước khi gửi.";
            return;
        }

        selectedTicket.Messages.Add(new SupportMessage
        {
            Sender = replyMode == "reply" ? "Hoàng Minh · RENTO" : "Hoàng Minh · Nội bộ",
            Content = replyContent.Trim(),
            IsStaff = replyMode == "reply",
            IsInternal = replyMode == "internal",
            Time = DateTime.Now
        });

        if (replyMode == "reply")
        {
            selectedTicket.Status = "Chờ phản hồi";
        }

        replyContent = "";
        replyError = "";
        attachmentName = "";
    }

    private void HandleAttachment(InputFileChangeEventArgs e)
    {
        var file = e.File;

        if (file.Size > 5 * 1024 * 1024)
        {
            replyError = "Tệp đính kèm không được vượt quá 5 MB.";
            attachmentName = "";
            return;
        }

        attachmentName = file.Name;
        replyError = "";
    }

    private static string GetInitials(string name)
    {
        return string.Join("", name.Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .TakeLast(2)
            .Select(x => char.ToUpperInvariant(x[0])));
    }

    private static string GetPriorityClass(string priority) => priority switch
    {
        "Cao" => "priority-high",
        "Trung bình" => "priority-medium",
        _ => "priority-low"
    };

    private static string GetStatusClass(string status) => status switch
    {
        "Đang xử lý" => "status-processing",
        "Chờ phản hồi" => "status-waiting",
        _ => "status-resolved"
    };

    private sealed class SupportTicket
    {
        public int Id { get; set; }
        public string Code { get; set; } = "";
        public string Title { get; set; } = "";
        public string Category { get; set; } = "";
        public string Customer { get; set; } = "";
        public string Phone { get; set; } = "";
        public string Email { get; set; } = "";
        public string Priority { get; set; } = "";
        public string Status { get; set; } = "";
        public string AssigneeCode { get; set; } = "";
        public string TimeAgo { get; set; } = "";
        public DateTime CreatedAt { get; set; }
        public string OrderCode { get; set; } = "";
        public string Car { get; set; } = "";
        public string RentalDate { get; set; } = "";
        public int TotalOrders { get; set; }
        public int PreviousTickets { get; set; }
        public List<SupportMessage> Messages { get; set; } = new();
    }

    private sealed class SupportMessage
    {
        public string Sender { get; set; } = "";
        public string Content { get; set; } = "";
        public string Attachment { get; set; } = "";
        public DateTime Time { get; set; }
        public bool IsStaff { get; set; }
        public bool IsSystem { get; set; }
        public bool IsInternal { get; set; }
    }
}
